# /etc/app.env — copy to /etc/app.env on the Lightsail instance
# chmod 600 /etc/app.env && chown root:root /etc/app.env
#
# Secrets (GITHUB_TOKEN, OPENWEATHER_API_KEY) are NOT stored here.
# They are fetched from AWS Secrets Manager at startup via the prod Spring profile.

PORT=8080
AWS_REGION=us-east-1
